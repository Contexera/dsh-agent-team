{
  "name": "@contexera/dsh-agent-team",
  "version": "0.2.2",
  "license": "MIT",
  "description": "A persistent agent team for long-running collaboration in DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/Contexera/dsh-agent-team.git"
  },
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "files": [
    "cordis.patch.yml",
    "packages/agent-team/lib/**/*",
    "packages/agent-team/core-skills/**/*",
    "packages/tool-agent-team/lib/**/*",
    "packages/client-agent-team/lib/**/*",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "generate:typert": "node --import tsx scripts/generate-typert.mjs",
    "prepack": "npm run build",
    "clean:build-outputs": "node scripts/clean-build-outputs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:core-skills": "node scripts/check-core-skills.mjs",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "check:facades": "node scripts/sync-paths.mjs --check",
    "check:artifact": "node scripts/check-artifact.mjs .",
    "check:public-baseline": "node scripts/check-public-baseline.mjs .",
    "test": "npm run generate:typert && npm run check:facades && npm run check:docs && npm run check:core-skills && npm run check:boundaries && npm run check:versions && vitest run",
    "test:browser": "npm run build && node scripts/run-browser-test.mjs",
    "preview": "node scripts/check-preview-credentials.mjs && npm run build && node scripts/run-preview.mjs",
    "preview:ui": "npm run build && node scripts/run-ui-preview.mjs",
    "lint": "corepack pnpm dlx oxlint@1.76.0 --disable-typescript-plugin packages scripts",
    "duplication": "jscpd --config .jscpd.json packages scripts",
    "typecheck": "npm run generate:typert && tsc -p packages/agent-team/tsconfig.json && tsc -p packages/tool-agent-team/tsconfig.json && tsc -p packages/client-agent-team/tsconfig.json",
    "build": "npm run clean:build-outputs && npm run generate:typert && tsc -p packages/agent-team/tsconfig.build.json && tsc -p packages/tool-agent-team/tsconfig.build.json && tsc -p packages/client-agent-team/tsconfig.build.json && node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@contexera/dsh-context-continuity": "^0.3.0",
    "@contexera/dsh-jev": "^0.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage-sqlite": "0.1.5-rc.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "use-sync-external-store": "1.2.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "main": "packages/client-agent-team/lib/index.js",
  "types": "packages/client-agent-team/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/client-agent-team/lib/types/index.d.ts",
      "default": "./packages/client-agent-team/lib/index.js"
    },
    "./host": {
      "types": "./packages/agent-team/lib/types/index.d.ts",
      "default": "./packages/agent-team/lib/index.js"
    },
    "./invariant": {
      "types": "./packages/agent-team/lib/types/invariant.d.ts",
      "default": "./packages/agent-team/lib/invariant.js"
    },
    "./types": {
      "types": "./packages/agent-team/lib/types/types.d.ts",
      "default": "./packages/agent-team/lib/types.js"
    },
    "./typert": {
      "types": "./packages/agent-team/lib/typert.host.d.ts",
      "default": "./packages/agent-team/lib/typert.host.js"
    },
    "./remote": {
      "types": "./packages/agent-team/lib/typert.remote-client.d.ts",
      "default": "./packages/agent-team/lib/typert.remote-client.js"
    },
    "./sqlite-backend": {
      "types": "./packages/agent-team/lib/types/vendor/storage-sqlite/index.d.ts",
      "default": "./packages/agent-team/lib/vendor/storage-sqlite/index.js"
    },
    "./compaction-engine": {
      "types": "./packages/agent-team/lib/types/compaction-engine.d.ts",
      "default": "./packages/agent-team/lib/compaction-engine.js"
    },
    "./member-context": {
      "types": "./packages/agent-team/lib/types/member-context.d.ts",
      "default": "./packages/agent-team/lib/member-context.js"
    },
    "./member-time-context": {
      "types": "./packages/agent-team/lib/types/member-time-context.d.ts",
      "default": "./packages/agent-team/lib/member-time-context.js"
    },
    "./time-format": {
      "types": "./packages/agent-team/lib/types/time-format.d.ts",
      "default": "./packages/agent-team/lib/time-format.js"
    },
    "./mentions": {
      "types": "./packages/agent-team/lib/types/mentions.d.ts",
      "default": "./packages/agent-team/lib/mentions.js"
    },
    "./member-skills": {
      "types": "./packages/agent-team/lib/types/member-skills.d.ts",
      "default": "./packages/agent-team/lib/member-skills.js"
    },
    "./tools": {
      "types": "./packages/tool-agent-team/lib/types/index.d.ts",
      "default": "./packages/tool-agent-team/lib/index.js"
    },
    "./client": {
      "types": "./packages/client-agent-team/lib/types/client/index.d.ts",
      "default": "./packages/client-agent-team/lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-agent-tool-presentation": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-app-boot": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-brand": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-command-compact": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-session-format-catalog": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-bash": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-jobs": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-pwsh": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-skill": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tool-web": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.2.1",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2 <0.2.1",
    "react": "^18.2.0"
  },
  "keywords": [
    "agent-team",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-agent",
    "agent-orchestration",
    "ai-agents",
    "deepseek",
    "multi-agent-systems"
  ]
}
